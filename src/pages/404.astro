---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="max-w-4xl mx-auto px-4 py-20 text-center space-y-6">
    <p class="text-7xl">🏚️</p>
    <h1 class="text-4xl sm:text-5xl font-bold">
      <span class="text-violet-400">404</span> — Página no encontrada
    </h1>
    <p class="text-slate-400 text-lg max-w-lg mx-auto">
      La página que buscas no existe o fue movida.
      Pero no te preocupes, ¡aún puedes seguir practicando japonés!
    </p>
    <a
      href="/"
      class="inline-block card px-6 py-3 font-medium text-violet-400 hover:text-violet-300 hover:border-violet-500 transition-all"
    >
      ← Volver al inicio
    </a>
  </div>
</Layout>
